# Скопируйте этот файл в .env и подставьте свои значения.
# НЕ коммитьте реальный .env в репозиторий.

# Строка подключения к базе данных.
# PostgreSQL (рекомендуется):
DATABASE_URL=postgresql+psycopg2://library:library@localhost:5432/library
# Локально для быстрого старта можно использовать SQLite:
# DATABASE_URL=sqlite:///./library.db

# Секретный ключ для подписи JWT.
# ОБЯЗАТЕЛЬНО замените на длинную случайную строку в продакшене.
SECRET_KEY=change-me-to-a-long-random-string

# Алгоритм подписи JWT.
ALGORITHM=HS256

# Время жизни access-токена в минутах.
ACCESS_TOKEN_EXPIRE_MINUTES=30
